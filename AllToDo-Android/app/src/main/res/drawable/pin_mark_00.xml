<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="100dp"
    android:height="125dp"
    android:viewportWidth="100"
    android:viewportHeight="125">

  <!-- Base Halo/Shadow for context (Shifted up with the feet) -->
  <ellipse cx="50" cy="55" rx="30" ry="10" android:fillColor="#000000" android:fillAlpha="0.2"/>

  <!-- Left Foot (Deep Arch) -->
  <group  android:translateX="35" android:translateY="30" android:rotation="-15">
    <!-- Sole with Deep Arch -->
    <!-- The path draws the heel, cuts in deep for the arch, then widens for the ball of the foot -->
    <path android:pathData="M4,4 C-1,4 -6,10 -6,16 C-6,21 -2,22 1,24 C-1,26 -4,29 -4,34 C-4,38 -1,40 3,40 C7,40 10,38 10,34 C10,29 7,26 6,24 C8,22 10,18 10,14 C10,8 8,4 4,4 Z" android:fillColor="white" android:strokeColor="#333333" android:strokeWidth="1"/>
    
    <!-- Toes (Rounded and distinct) -->
    <ellipse cx="-4" cy="2" rx="2.2" ry="3" android:fillColor="white" android:strokeColor="#333333" android:strokeWidth="1"/>
    <ellipse cx="-0.5" cy="-0.5" rx="1.8" ry="2.4" android:fillColor="white" android:strokeColor="#333333" android:strokeWidth="1"/>
    <ellipse cx="2.5" cy="0.5" rx="1.6" ry="2.2" android:fillColor="white" android:strokeColor="#333333" android:strokeWidth="1"/>
    <ellipse cx="5" cy="1.5" rx="1.4" ry="2" android:fillColor="white" android:strokeColor="#333333" android:strokeWidth="1"/>
    <ellipse cx="7.5" cy="3" rx="1.2" ry="1.8" android:fillColor="white" android:strokeColor="#333333" android:strokeWidth="1"/>
  </group>

  <!-- Right Foot (Deep Arch) -->
  <group  android:translateX="65" android:translateY="20" android:rotation="15">
    <!-- Sole with Deep Arch -->
    <path android:pathData="M4,4 C-1,4 -6,10 -6,16 C-6,21 -2,22 1,24 C-1,26 -4,29 -4,34 C-4,38 -1,40 3,40 C7,40 10,38 10,34 C10,29 7,26 6,24 C8,22 10,18 10,14 C10,8 8,4 4,4 Z" android:fillColor="white" android:strokeColor="#333333" android:strokeWidth="1"/>
    
    <!-- Toes -->
    <ellipse cx="-4" cy="2" rx="2.2" ry="3" android:fillColor="white" android:strokeColor="#333333" android:strokeWidth="1"/>
    <ellipse cx="-0.5" cy="-0.5" rx="1.8" ry="2.4" android:fillColor="white" android:strokeColor="#333333" android:strokeWidth="1"/>
    <ellipse cx="2.5" cy="0.5" rx="1.6" ry="2.2" android:fillColor="white" android:strokeColor="#333333" android:strokeWidth="1"/>
    <ellipse cx="5" cy="1.5" rx="1.4" ry="2" android:fillColor="white" android:strokeColor="#333333" android:strokeWidth="1"/>
    <ellipse cx="7.5" cy="3" rx="1.2" ry="1.8" android:fillColor="white" android:strokeColor="#333333" android:strokeWidth="1"/>
  </group>

</vector>