<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="100dp"
    android:height="125dp"
    android:viewportWidth="100"
    android:viewportHeight="125">

  <!-- Trapezoid Base (Gray 7) - Shifted up by 5 units -->
  <path android:pathData="M35,53 L65,53 L75,63 L25,63 Z" android:fillColor="#8E8E93" />

  <!-- Path: Wandering Trail (Bolder & Shifted up) -->
  <group  android:translateX="0" android:translateY="-5">
    <!-- Bolder Trail Path (Stroke 6, Dash 0.1 10) -->
    <path android:pathData="M50,58 Q85,58 50,44 Q15,44 50,30" 
          android:fillColor="none" 
          android:strokeColor="white" 
          android:strokeWidth="6" 
          stroke-dasharray="0.1 10" 
          android:strokeLineCap="round" />

    <!-- Starting Point: Blue Solid Dot (Enlarged to r=6) -->
    <path android:pathData="M 44.0,58.0 a 6.0,6.0 0 1,0 12.0,0 a 6.0,6.0 0 1,0 -12.0,0"  android:fillColor="#007AFF" android:strokeColor="white" android:strokeWidth="2"  />

    <!-- Current Point: Large White Solid Dot (Enlarged to r=11) -->
    <path android:pathData="M 39.0,30.0 a 11.0,11.0 0 1,0 22.0,0 a 11.0,11.0 0 1,0 -22.0,0"  android:fillColor="white"  />
  </group>

</vector>