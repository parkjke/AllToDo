<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- 1. Shadow Box (Translated by 20,20) -->
    <!-- Original: x=262, y=262, w=500, h=500, rx=40. Translate(20,20) => x=282, y=282 -->
    <!-- RX=40 means rounded rect. Android path for rounded rect is tedious, but we can approximate or use a simple path. -->
    <!-- Let's use a path for a rounded rectangle. -->
    <!-- M x+rx, y L x+w-rx, y Q x+w, y x+w, y+rx L x+w, y+h-rx Q x+w, y+h x+w-rx, y+h L x+rx, y+h Q x, y+h x, y+h-rx L x, y+rx Q x, y x+rx, y Z -->
    
    <!-- Shadow: x=282, y=282, w=500, h=500, r=40 -->
    <path
        android:fillColor="#000000"
        android:fillAlpha="0.2"
        android:pathData="M322,282 L742,282 A40,40 0 0 1 782,322 L782,742 A40,40 0 0 1 742,782 L322,782 A40,40 0 0 1 282,742 L282,322 A40,40 0 0 1 322,282 z" />

    <!-- 2. Main Blue Box -->
    <!-- Box: x=262, y=262, w=500, h=500, r=40. Fill #4A90E2, Stroke #357ABD width 20 -->
    <!-- Android vector stroke works like SVG centered stroke. -->
    <path
        android:fillColor="#4A90E2"
        android:strokeColor="#357ABD"
        android:strokeWidth="20"
        android:pathData="M302,262 L722,262 A40,40 0 0 1 762,302 L762,722 A40,40 0 0 1 722,762 L302,762 A40,40 0 0 1 262,722 L262,302 A40,40 0 0 1 302,262 z" />

    <!-- 3. Checkmark -->
    <!-- Path: M380 530 L 480 630 L 660 410, Stroke White, Width 80, Round Caps/Joins -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="80"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M380 530 L 480 630 L 660 410" />

</vector>
